{
  "name": "ray-poker",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter frontend run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build:shared": "pnpm --filter @ray-poker/shared build",
    "build:backend": "pnpm --filter @ray-poker/shared build && pnpm --filter backend build",
    "build:frontend": "pnpm --filter @ray-poker/shared build && pnpm --filter frontend build"
  }
}
